---
import { getAudioUrlFromKey, LOCAL_API_URL } from "../lib";
import type { GetWordDetailsResponse } from "../../../shared/types";
import {
  getWordDetails,
  getTitleForWord,
  getAllWords,
  buildDefListProps,
} from "../lib";
import WordForms from "./WordForms.astro";

// Define the component's props interface
export type DefListProps = {
  word: GetWordDetailsResponse["word"];
  definitions: {
    definition: GetWordDetailsResponse["definitions"][number]["definition"];
    partOfSpeech: GetWordDetailsResponse["definitions"][number]["partOfSpeech"];
    // In Astro, these will be strings of HTML or just text
    builtDefinition: string | any;
    sentences: (GetWordDetailsResponse["definitions"][number]["sentences"][number] & {
      builtSentence: string | any;
    })[];
  }[];
};

interface Props {
  word: string;
}

const { word } = Astro.props;

const svg = {
  copy: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>`,
  volume: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-volume2 h-4 w-4"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path><path d="M16 9a5 5 0 0 1 0 6"></path><path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path></svg>`,
  pause: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="4" height="16" x="6" y="4"></rect><rect width="4" height="16" x="14" y="4"></rect></svg>`,
  spinner: `<svg class="spin" />`,
};

const wordDetails = await getWordDetails({ word });
const allWords = await getAllWords();

// Build props
const defListProps = buildDefListProps({
  wordDetails,
  allWords,
});
---

<div id="def-list-container">
  <div class="wrd">
    <h1>{defListProps.word}</h1>
    <WordForms wordDetails={wordDetails} />
  </div>

  <ul class="defList">
    {
      defListProps.definitions.map((def: any) => (
        <li>
          <div class="def__header">
            <div>
              <span class="mark" />
            </div>
            <p class="def__text">
              <span>{`${def.partOfSpeech}:`}</span>
              <i set:html={def.builtDefinition} />
            </p>
          </div>

          <ul class="sentList">
            {def.sentences.map((sentenceItem: any) => (
              <li>
                <p set:html={sentenceItem.builtSentence} />
                <div>
                  <button
                    class="btn__ghst cpy"
                    aria-label="Copy"
                    data-cpy
                    data-sentence={sentenceItem.sentence}
                  >
                    <Fragment set:html={svg.copy} />
                  </button>

                  <button
                    class="btn__ghst lstn text-muted-foreground"
                    aria-label="Listen"
                    data-lst
                    data-audio-key={sentenceItem.audio}
                  >
                    <Fragment set:html={svg.volume} />
                  </button>
                </div>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>
</div>

<script>
  import { AUDIO_URL } from "../lib";

  // Wait for the DOM to be fully loaded
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("def-list-container");
    if (!container) return;

    // === STATE MANAGEMENT ===
    let playingKey: any = null;
    let currentAudio: any = null;
    let currentPlayingButton: any = null;
    const blobUrlCache = new Map();
    const MAX_CACHE = 30;

    // === SVG ICONS ===
    const svgIcons = {
      copy: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>`,
      volume: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-volume2 h-4 w-4"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path><path d="M16 9a5 5 0 0 1 0 6"></path><path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path></svg>`,
      pause: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><rect width="4" height="16" x="6" y="4"></rect><rect width="4" height="16" x="14" y="4"></rect></svg>`,
      spinner: `<svg class="spin" />`,
    };

    // === EVENT HANDLING ===
    container.addEventListener("click", (e) => {
      const copyButton = (e.target as HTMLElement).closest("[data-cpy]");
      const listenButton = (e.target as HTMLElement).closest("[data-lst]");

      if (copyButton) {
        handleCopy(copyButton as HTMLButtonElement);
      }
      if (listenButton) {
        handlePlay(listenButton as HTMLButtonElement);
      }
    });

    // === CORE LOGIC ===
    const handleCopy = async (button: any) => {
      await navigator.clipboard.writeText(button.dataset.sentence);
    };

    const setButtonState = (button: any, state: any) => {
      if (!button) return;
      switch (state) {
        case "loading":
          button.innerHTML = svgIcons.spinner;
          button.disabled = true;
          break;
        case "playing":
          button.innerHTML = svgIcons.pause;
          button.disabled = false;
          button.classList.add("text-primary!"); // Check if ! is needed for your CSS
          button.classList.remove("text-muted-foreground");
          break;
        case "default":
          button.innerHTML = svgIcons.volume;
          button.disabled = false;
          button.classList.remove("text-primary!");
          button.classList.add("text-muted-foreground");
          break;
      }
    };

    const teardownCurrentAudio = () => {
      console.log("Tearing down current audio");
      if (currentAudio) {
        currentAudio.pause();
        // currentAudio.src = ""; // Release resources
        currentAudio = null;
      }
      if (currentPlayingButton) {
        setButtonState(currentPlayingButton, "default");
        currentPlayingButton = null;
      }
      playingKey = null;
    };

    const getCachedSrc = async (key: any, rawUrl: any) => {
      if (blobUrlCache.has(key)) {
        return blobUrlCache.get(key);
      }

      const res = await fetch(rawUrl, { cache: "force-cache" });
      if (!res.ok) throw new Error("Failed to fetch audio");
      const blob = await res.blob();
      const objUrl = URL.createObjectURL(blob);

      if (blobUrlCache.size >= MAX_CACHE) {
        const oldestKey = blobUrlCache.keys().next().value;
        URL.revokeObjectURL(blobUrlCache.get(oldestKey));
        blobUrlCache.delete(oldestKey);
      }
      blobUrlCache.set(key, objUrl);
      return objUrl;
    };

    const handlePlay = async (button: any) => {
      const audioKey = button.dataset.audioKey;
      console.log("Handle play for audio key:", audioKey);

      if (audioKey === playingKey) {
        console.log("Audio is already playing, stopping it.");
        teardownCurrentAudio();
        return;
      }

      // Stop any previously playing audio first
      teardownCurrentAudio();

      // Set new state
      playingKey = audioKey;
      currentPlayingButton = button;
      if (!blobUrlCache.has(audioKey)) {
        setButtonState(button, "loading");
      }

      function getAudioUrlFromKey(key: string): string | null {
        if (!key) return null;
        return `${AUDIO_URL}${key}`;
      }

      const audioURL = getAudioUrlFromKey(audioKey);

      const rawUrl = import.meta.env.DEV
        ? `http://localhost:5555/api/proxy?url=${encodeURIComponent(audioURL!)}`
        : audioURL;

      try {
        const src = await getCachedSrc(audioKey, rawUrl);
        const audio = new Audio(src);
        currentAudio = audio;

        audio.addEventListener("ended", () => {
          console.log("Audio ended");
          teardownCurrentAudio();
          console.log("Teardown complete after audio ended");
        });

        audio.addEventListener("canplaythrough", () => {
          if (audioKey === playingKey) {
            // Ensure we are still the active audio
            setButtonState(button, "playing");
          }
        });

        audio.addEventListener("error", (e) => {
          console.error("Audio playback error:", e);
        });

        await audio.play();
      } catch (e) {
        console.error("Failed to load audio:", e);
        teardownCurrentAudio(); // Clean up on failure
      }
    };
  });
</script>
