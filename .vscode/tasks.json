{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "astro dev",
      "type": "shell",
      "command": "pnpm dev",
      "options": {
        "cwd": "${workspaceFolder}/astro"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev-group"
      }
    },
    {
      "label": "admin api",
      "type": "shell",
      "command": "pnpm dev:admin",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "group": "dev-group"
      }
    },
    {
      "label": "Start All",
      "dependsOn": ["astro dev", "admin api"],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
